{
	"compilerOptions": {
		"module": "Node16",
		"moduleResolution": "node16",
		"target": "es6",
		"outDir": "out",
		"rootDir": "src",
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"strict": true,
		"esModuleInterop": true
	},
	"include": ["src"],
	"exclude": ["node_modules", "out"]
}
