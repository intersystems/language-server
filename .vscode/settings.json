{
	"editor.insertSpaces": false,
	"tslint.enable": true,
	"js/ts.tsc.autoDetect": "off",
	"js/ts.preferences.quoteStyle": "single",
	// js-debug's Network view hooks the server's HTTP requests; with it on, "Attach to Server"
	// debug sessions intermittently crash.
	"debug.javascript.enableNetworkView": false
